generator client {
  provider = "prisma-client"
  output   = "../../prisma"
}

datasource db {
  provider = "postgresql"
}

model Cat {
  id        String   @id @default(cuid())
  name      String
  age       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Todo {
  id        String  @id @default(cuid())
  title     String
  completed Boolean @default(false)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String
  password  String
  todos     Todo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
